	column 'Units Sold' = SUMX(RELATEDTABLE(Sales), Sales[Quantity])
		formatString: 0
		lineageTag: 2bbd4be6-4cf3-4452-8fd0-970a58f736ef
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Popularity = ```
			
			VAR UnitsByAverage = Products[Units Sold] / AVERAGE(Products[Units Sold])
			RETURN
			IF(
			    UnitsByAverage >= 1.01,
			    "Fast Moving",
			    IF(
			        UnitsByAverage >= 1,
			        "Popular",
			        IF(
			            UnitsByAverage >= 0.98,
			            "Average",
			            "Slow Moving"
			        )
			    )
			)
			
			```
		lineageTag: d491996e-7951-4ae6-b752-814b6a3c9662
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

