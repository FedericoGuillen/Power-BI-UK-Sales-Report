	column 'Range Categories' =
			SWITCH(
				TRUE,
				ISBLANK('Products'[Product Range]),
				"(Blank)",
				'Products'[Product Range] IN {"Brainster",
					"Digispace",
					"Kaymba"},
				"Economy",
				'Products'[Product Range] IN {"Gemia",
					"Pixope",
					"Yalia"},
				"Luxury",
				'Products'[Product Range] IN {"Camindu",
					"Divazz",
					"Mytri"},
				"Standard",
				'Products'[Product Range]
			)
		lineageTag: e7b15e8c-5a5e-4009-8900-8c9b6007088a
		summarizeBy: none

