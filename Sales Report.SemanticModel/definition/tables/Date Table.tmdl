	partition 'Date Table' = calculated
		mode: import
		source = ```
				
				VAR DateColumn = 
				CALENDAR(
				    DATE(YEAR(MIN(Sales[Invoice Date])), 1, 1),
				    DATE(YEAR(MAX(Sales[Invoice Date])), 12, 31)
				)
				RETURN
				ADDCOLUMNS(
				    DateColumn,
				    "Year", YEAR([Date]),
				    "Quarter", QUARTER([Date]),
				    "Month", FORMAT([Date], "MMMM"),
				    "Month Sort", MONTH([Date]),
				    "Month Short", FORMAT([Date], "MMM"),
				    "Day", DAY([Date]),
				    "Year & Month", FORMAT([Date], "YYMM")
				)
				```

	annotation PBI_Id = 3913bc579adb48af8951f2547d801ad2

