	partition 'Temporary Weekend Units' = calculated
		mode: import
		source = ```
				
				FILTER(
				    Sales,
				    WEEKDAY(Sales[Invoice Date], 2) > 5
				)
				
				```

	annotation PBI_Id = 365ed5800ce340ebb054d8985eac090b

