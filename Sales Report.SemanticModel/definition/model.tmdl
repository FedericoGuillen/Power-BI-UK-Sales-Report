model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-MX
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Date Table Practice'

	annotation PBI_QueryGroupOrder = 0

annotation PBI_QueryOrder = ["Branch Targets","Branches","Clients","Products","Sales","Staff","EarliestDate","LatestDate","M Date Table","External Date Table","EarliestYear","LatestYear","Purchase Orders","_Measures","Industry Margins"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table 'Branch Targets'
ref table Branches
ref table Clients
ref table Products
ref table Sales
ref table Staff
ref table 'Date Table'
ref table 'Purchase Orders'
ref table 'Auto Date Table'
ref table 'Temporary Invoices'
ref table 'Temporary Weekend Units'
ref table _Measures
ref table 'Industry Margins'

ref cultureInfo en-US

